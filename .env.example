PORT=3000

DATABASE_URL="postgresql://USUARIO:SENHA@localhost:5432/plataforma_avaliacao?schema=public"

JWT_SECRET="defina_um_segredo_com_32_caracteres_ou_mais"
JWT_EXPIRES_IN="1h"

FRONTEND_URL="http://127.0.0.1:5500"

# Bootstrap do administrador (script admin:create)
BOOTSTRAP_ADMIN_NAME="Administrador"
BOOTSTRAP_ADMIN_EMAIL="admin@escola.dev"
