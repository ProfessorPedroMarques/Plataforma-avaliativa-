# Arquivos enviados pelos alunos
#  database = guardados no PostgreSQL (padrão; obrigatório em hospedagem gratuita como o Render)
#  disk     = guardados na pasta UPLOAD_DIR (servidor próprio com disco permanente)
FILE_STORAGE="database"
UPLOAD_DIR="uploads"
MAX_UPLOAD_MB=20
